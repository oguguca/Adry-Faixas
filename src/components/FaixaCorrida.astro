---
// Faixa com os serviços passando em loop. tema "escura" = fundo preto e texto laranja, para usar sobre fundo laranja.
interface Props {
  tema?: 'laranja' | 'escura';
}
const { tema = 'laranja' } = Astro.props;
const itens = ['Faixas pintadas à mão', 'Banners', 'Fachadas', 'Letreiros', 'Adesivos', 'Placas', 'Vitrines', 'Veículos'];
---

<div class:list={['faixa-corrida', `faixa-corrida--${tema}`]} aria-hidden="true">
  <div class="faixa-trilho">
    {
      [0, 1].map(() => (
        <ul>
          {itens.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .faixa-corrida {
    background: var(--laranja);
    color: #000;
    overflow: hidden;
    border-block: 3px solid var(--preto);
  }
  .faixa-corrida--escura { background: var(--preto); color: var(--laranja); border-color: var(--preto); }
  /* Duas cópias da lista lado a lado; anda -50% e recomeça sem emenda. */
  .faixa-trilho { display: flex; width: max-content; animation: faixa-andar 32s linear infinite; }
  .faixa-corrida:hover .faixa-trilho { animation-play-state: paused; }
  .faixa-trilho ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .faixa-trilho li {
    font-family: var(--fonte-titulo);
    text-transform: uppercase;
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1;
    padding: 14px 0;
    white-space: nowrap;
  }
  .faixa-trilho li::after { content: '★'; margin: 0 28px; font-size: 0.6em; vertical-align: 0.25em; }

  @keyframes faixa-andar {
    to { transform: translateX(-50%); }
  }
</style>
