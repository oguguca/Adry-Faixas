---
import IconeWhatsapp from './IconeWhatsapp.astro';
import { portfolio, TELA_LEVE, whatsappLink } from '../data/site';

const categorias = ['Todos', ...new Set(portfolio.map((t) => t.categoria))];
---

<section class="secao portfolio" id="portfolio">
  <div class="container">
    <div class="portfolio-topo" data-reveal-grupo>
      <div>
        <span class="tag">Portfólio</span>
        <h2 class="titulo-secao">Trabalho que <span>aparece.</span></h2>
      </div>
      <div class="filtros" role="group" aria-label="Filtrar trabalhos">
        {categorias.map((c, i) => <button type="button" data-filtro={c} aria-pressed={i === 0 ? 'true' : 'false'}>{c}</button>)}
      </div>
    </div>

    <ul class="mosaico" data-reveal-grupo data-tela-leve={TELA_LEVE}>
      {
        portfolio.map((t) => (
          <li
            class={`item item--${t.tipo}`}
            data-categoria={t.categoria}
            {...(t.tipo !== 'antes-depois' && {
              'data-abrir': '',
              'data-tipo': t.tipo,
              'data-midia': t.src,
              'data-inicio': t.start ?? 0,
              'data-leve': t.leve,
              'data-titulo': t.titulo,
              'data-wa': whatsappLink(`Olá! Vi o trabalho "${t.titulo}" no site da Adry e quero algo parecido.`),
              tabindex: 0,
              role: 'button',
              'aria-label': `Ver ${t.titulo} em tela cheia`,
            })}
          >
            {t.tipo === 'antes-depois' ? (
              <div class="ad" style="--pos: 50%">
                <img src={t.antes} alt={`${t.titulo}: antes`} loading="lazy" decoding="async" />
                <img class="ad-depois" src={t.src} alt={`${t.titulo}: depois`} loading="lazy" decoding="async" />
                <span class="ad-linha" aria-hidden="true"><i>⟷</i></span>
                <span class="ad-rotulo ad-rotulo-antes">Antes</span>
                <span class="ad-rotulo ad-rotulo-depois">Depois</span>
                <input type="range" min="0" max="100" value="50" aria-label="Comparar antes e depois" />
              </div>
            ) : t.tipo === 'video' ? (
              <video
                data-src={`${t.src}#t=${t.start ?? 0}`}
                data-start={t.start ?? 0}
                data-end={t.end}
                data-leve={t.leve}
                muted
                playsinline
                preload="none"
                aria-label={t.titulo}
              />
            ) : (
              <img src={t.src} alt={t.titulo} loading="lazy" decoding="async" />
            )}
            <div class="item-info">
              <span>{t.categoria}</span>
              <strong>{t.titulo}</strong>
            </div>
            {t.tipo === 'video' && <span class="item-video">▶ Vídeo</span>}
            {t.tipo !== 'antes-depois' && <span class="item-ampliar" aria-hidden="true">⤢</span>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<dialog class="lb" aria-label="Trabalho em tela cheia" data-lb>
  <button type="button" class="lb-fechar" data-lb-fechar aria-label="Fechar">×</button>
  <button type="button" class="lb-seta lb-anterior" data-lb-anterior aria-label="Trabalho anterior">‹</button>
  <figure class="lb-figura">
    <div class="lb-midia" data-lb-midia></div>
    <figcaption class="lb-legenda">
      <div>
        <span data-lb-categoria></span>
        <strong data-lb-titulo></strong>
      </div>
      <div class="lb-acoes">
        <span class="lb-contador" data-lb-contador></span>
        <a class="btn btn-wa lb-wa" data-lb-wa href="#" target="_blank" rel="noopener">
          <IconeWhatsapp /> Quero algo assim
        </a>
      </div>
    </figcaption>
  </figure>
  <button type="button" class="lb-seta lb-proximo" data-lb-proximo aria-label="Próximo trabalho">›</button>
</dialog>

<script>
  const botoes = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filtro]'));
  const itens = Array.from(document.querySelectorAll<HTMLElement>('.mosaico .item'));

  botoes.forEach((b) =>
    b.addEventListener('click', () => {
      const filtro = b.dataset.filtro;
      botoes.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      itens.forEach((it) => {
        it.hidden = filtro !== 'Todos' && it.dataset.categoria !== filtro;
      });
    }),
  );

  // Barra de comparação do antes e depois.
  document.querySelectorAll<HTMLElement>('.ad').forEach((ad) => {
    const range = ad.querySelector('input')!;
    range.addEventListener('input', () => ad.style.setProperty('--pos', `${range.value}%`));
  });

  // Celular/tablet: vídeos leves já cortados no trecho (sem pular no vídeo), em loop, com capa.
  const telaLeve = window.matchMedia(document.querySelector<HTMLElement>('.mosaico')!.dataset.telaLeve!).matches;
  if (telaLeve) {
    document.querySelectorAll<HTMLVideoElement>('.mosaico video[data-leve]').forEach((v) => {
      v.dataset.src = `${v.dataset.leve}.mp4`;
      v.dataset.start = '0';
      delete v.dataset.end;
      v.poster = `${v.dataset.leve}.jpg`;
      v.loop = true;
    });
  }

  // Vídeos do portfólio só carregam e tocam quando aparecem na tela.
  const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const obs = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) {
          if (!v.src) v.src = v.dataset.src!;
          if (!reduzido) v.play().catch(() => {});
        } else {
          v.pause();
        }
      });
    },
    { threshold: 0.4 },
  );
  document.querySelectorAll<HTMLVideoElement>('.mosaico video').forEach((v) => {
    // Repete só o trecho [start, end] (ou do start até o fim do vídeo).
    const start = Number(v.dataset.start);
    const end = v.dataset.end ? Number(v.dataset.end) : Infinity;
    v.addEventListener('timeupdate', () => {
      if (v.currentTime >= end) v.currentTime = start;
    });
    v.addEventListener('ended', () => {
      v.currentTime = start;
      v.play().catch(() => {});
    });
    obs.observe(v);
  });

  // Lightbox: abre foto ou vídeo em tela cheia, navega entre os trabalhos visíveis no filtro atual.
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]')!;
  const lbMidia = lb.querySelector<HTMLElement>('[data-lb-midia]')!;
  const lbTitulo = lb.querySelector<HTMLElement>('[data-lb-titulo]')!;
  const lbCategoria = lb.querySelector<HTMLElement>('[data-lb-categoria]')!;
  const lbContador = lb.querySelector<HTMLElement>('[data-lb-contador]')!;
  const lbWa = lb.querySelector<HTMLAnchorElement>('[data-lb-wa]')!;
  const abriveis = itens.filter((it) => it.hasAttribute('data-abrir'));
  let lista: HTMLElement[] = [];
  let pos = 0;
  let origem: HTMLElement | null = null;

  const mostrar = (n: number) => {
    pos = (n + lista.length) % lista.length;
    const it = lista[pos];
    const d = it.dataset;
    lbMidia.replaceChildren();
    if (d.tipo === 'video') {
      const v = document.createElement('video');
      if (telaLeve && d.leve) {
        v.src = `${d.leve}.mp4`;
        v.poster = `${d.leve}.jpg`;
        v.loop = true;
      } else {
        v.src = `${d.midia}#t=${d.inicio}`;
      }
      v.controls = true;
      v.autoplay = true;
      v.playsInline = true;
      // Vídeos sem áudio: mantém mudo mesmo se mexerem no volume dos controles.
      v.muted = true;
      v.addEventListener('volumechange', () => {
        if (!v.muted) v.muted = true;
      });
      lbMidia.append(v);
    } else {
      const img = document.createElement('img');
      img.src = d.midia!;
      img.alt = d.titulo!;
      lbMidia.append(img);
    }
    lbTitulo.textContent = d.titulo!;
    lbCategoria.textContent = d.categoria!;
    lbContador.textContent = `${pos + 1} / ${lista.length}`;
    lbWa.href = d.wa!;
  };

  const abrirLb = (it: HTMLElement) => {
    lista = abriveis.filter((x) => !x.hidden);
    origem = it;
    document.querySelectorAll<HTMLVideoElement>('.mosaico video').forEach((v) => v.pause());
    mostrar(lista.indexOf(it));
    lb.showModal();
    document.documentElement.style.overflow = 'hidden';
  };

  lb.addEventListener('close', () => {
    lbMidia.replaceChildren();
    document.documentElement.style.overflow = '';
    origem?.focus();
  });

  abriveis.forEach((it) => {
    it.addEventListener('click', () => abrirLb(it));
    it.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        abrirLb(it);
      }
    });
  });

  lb.querySelector('[data-lb-fechar]')!.addEventListener('click', () => lb.close());
  lb.querySelector('[data-lb-anterior]')!.addEventListener('click', () => mostrar(pos - 1));
  lb.querySelector('[data-lb-proximo]')!.addEventListener('click', () => mostrar(pos + 1));
  // Clique no fundo escuro (fora da figura e dos botões) fecha.
  lb.addEventListener('click', (e) => {
    if (e.target === lb) lb.close();
  });
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') mostrar(pos - 1);
    if (e.key === 'ArrowRight') mostrar(pos + 1);
  });
</script>

<style>
  .portfolio { background: var(--preto-2); }
  .portfolio-topo { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .filtros { display: flex; flex-wrap: wrap; gap: 8px; }
  .filtros button {
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    color: var(--cinza-claro);
    background: transparent;
    border: 1px solid var(--preto-3);
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
  }
  .filtros button:hover { border-color: var(--laranja); }
  .filtros button[aria-pressed='true'] { background: var(--laranja); border-color: var(--laranja); color: #000; }

  .mosaico {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 260px;
    grid-auto-flow: dense;
    gap: 12px;
  }
  .item { position: relative; overflow: hidden; border-radius: var(--raio); background: var(--preto-3); }
  .item[hidden] { display: none; }
  .item:has(video) { grid-row: span 2; }
  .item--antes-depois { grid-column: span 2; grid-row: span 2; }
  .item[data-abrir] { cursor: zoom-in; }
  .item[data-abrir]:focus-visible { outline: 3px solid var(--laranja); outline-offset: 3px; }
  .item-ampliar {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 18px;
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .item:hover .item-ampliar, .item:focus-visible .item-ampliar { opacity: 1; transform: none; }

  .lb {
    width: 100vw;
    height: 100svh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(8, 8, 8, 0.97);
    color: var(--branco);
    overflow: hidden;
  }
  .lb[open] { display: grid; grid-template-columns: 72px 1fr 72px; align-items: center; animation: lb-entrar 0.2s ease; }
  .lb::backdrop { background: transparent; }
  .lb-figura {
    margin: 0;
    height: 100svh;
    padding: 64px 0 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .lb-midia { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; }
  /* :global porque img/video são criados via JS e não recebem o escopo do Astro. */
  .lb-midia :global(img), .lb-midia :global(video) {
    max-width: 100%;
    /* Tela menos o respiro de cima/baixo e a legenda. */
    max-height: calc(100svh - 170px);
    object-fit: contain;
    width: auto;
    height: auto;
    border-radius: var(--raio);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    background: #000;
  }
  .lb-legenda { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .lb-legenda span[data-lb-categoria] {
    display: block;
    color: var(--laranja);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .lb-legenda strong { font-family: var(--fonte-titulo); font-weight: 400; font-size: 28px; text-transform: uppercase; line-height: 1.1; }
  .lb-acoes { display: flex; align-items: center; gap: 16px; }
  .lb-contador { color: var(--cinza); font-size: 14px; font-variant-numeric: tabular-nums; }
  .lb-wa { padding: 12px 18px; font-size: 14px; }
  .lb-fechar, .lb-seta {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    border-radius: 50%;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.15s ease;
  }
  .lb-fechar:hover, .lb-seta:hover { background: var(--laranja); color: #000; }
  .lb-fechar:focus-visible, .lb-seta:focus-visible { outline: 3px solid var(--laranja); outline-offset: 2px; }
  .lb-fechar { position: absolute; top: 14px; right: 16px; width: 44px; height: 44px; font-size: 28px; line-height: 1; z-index: 2; }
  .lb-seta { justify-self: center; width: 52px; height: 52px; font-size: 34px; line-height: 1; padding-bottom: 4px; }

  @keyframes lb-entrar { from { opacity: 0; } to { opacity: 1; } }

  @media (max-width: 680px) {
    .lb[open] { grid-template-columns: 1fr; }
    .lb-figura { padding: 60px 12px 16px; }
    .lb-seta { position: absolute; bottom: 96px; z-index: 2; width: 44px; height: 44px; font-size: 28px; }
    .lb-anterior { left: 12px; }
    .lb-proximo { right: 12px; }
    .lb-legenda strong { font-size: 22px; }
  }

  .ad { position: relative; width: 100%; height: 100%; user-select: none; }
  .ad img { position: absolute; inset: 0; }
  .ad-depois { clip-path: inset(0 0 0 var(--pos)); }
  .item:hover .ad img { transform: none; }
  .ad-linha {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 3px;
    margin-left: -1.5px;
    background: var(--laranja);
    pointer-events: none;
  }
  .ad-linha i {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--laranja);
    color: #000;
    display: grid;
    place-items: center;
    font-style: normal;
    font-weight: 900;
    font-size: 20px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
  }
  .ad-rotulo {
    position: absolute;
    top: 14px;
    background: rgba(0, 0, 0, 0.7);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 5px 9px;
    pointer-events: none;
  }
  .ad-rotulo-antes { left: 14px; }
  .ad-rotulo-depois { right: 14px; background: var(--laranja); color: #000; }
  .ad input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    z-index: 2;
  }
  .ad:has(input:focus-visible) .ad-linha i { outline: 3px solid #fff; outline-offset: 2px; }
  .item img, .item video { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .item:hover img, .item:hover video { transform: scale(1.04); }
  .item-info {
    position: absolute;
    inset: auto 0 0 0;
    padding: 40px 16px 14px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
    display: flex;
    flex-direction: column;
    font-size: 14px;
  }
  .item-info span { color: var(--laranja); font-size: 11px; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; }
  .item-video {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--laranja);
    color: #000;
    font-size: 11px;
    font-weight: 800;
    padding: 4px 8px;
    text-transform: uppercase;
  }

  /* Com 3 colunas o mosaico sobra um buraco; 2 colunas fecham certinho. */
  @media (max-width: 960px) { .mosaico { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 240px; } }
  @media (max-width: 680px) { .mosaico { grid-auto-rows: 200px; } }
</style>
