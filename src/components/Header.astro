---
import Logo from './Logo.astro';
import IconeWhatsapp from './IconeWhatsapp.astro';
import { whatsappLink } from '../data/site';
---

<header class="header">
  <div class="container header-inner">
    <!-- "#top" sem elemento com esse id rola para o início da página (padrão do HTML). -->
    <a href="#top" aria-label="Voltar ao início"><Logo /></a>
    <nav class="nav" id="menu-principal" aria-label="Principal" data-menu>
      <a href="#servicos">Serviços</a>
      <a href="#portfolio">Portfólio</a>
      <a href="#como-funciona">Como funciona</a>
      <a href="#contato">Contato</a>
    </nav>
    <div class="header-acoes">
      <a class="btn btn-wa header-cta" href={whatsappLink()} target="_blank" rel="noopener">
        <IconeWhatsapp /> <span>WhatsApp</span>
      </a>
      <button
        type="button"
        class="menu-botao"
        aria-controls="menu-principal"
        aria-expanded="false"
        aria-label="Abrir menu"
        data-menu-botao
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Menu do celular/tablet: abre abaixo do header e fecha ao escolher um link.
  const botao = document.querySelector<HTMLButtonElement>('[data-menu-botao]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const header = botao.closest('.header')!;

  const abrir = (sim: boolean) => {
    header.classList.toggle('menu-aberto', sim);
    botao.setAttribute('aria-expanded', String(sim));
    botao.setAttribute('aria-label', sim ? 'Fechar menu' : 'Abrir menu');
  };

  botao.addEventListener('click', () => abrir(!header.classList.contains('menu-aberto')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => abrir(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.classList.contains('menu-aberto')) {
      abrir(false);
      botao.focus();
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(14, 14, 14, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--preto-3);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }
  .header.rolado { background: rgba(14, 14, 14, 0.96); box-shadow: 0 8px 30px rgba(0, 0, 0, 0.45); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: var(--altura-header); }
  .nav { display: flex; gap: 32px; font-size: 14px; font-weight: 500; color: var(--cinza-claro); }
  .nav a:hover { color: var(--laranja); }
  .header-acoes { display: flex; align-items: center; gap: 10px; }
  .header-cta { padding: 10px 16px; font-size: 14px; }

  .menu-botao {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    border: 1px solid var(--preto-3);
    background: transparent;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  .menu-botao:focus-visible { outline: 3px solid var(--laranja); outline-offset: 2px; }
  .menu-botao span { display: block; width: 20px; height: 2px; background: var(--branco); transition: transform 0.25s ease, opacity 0.2s ease; }
  /* Três linhas viram um X quando o menu abre. */
  .menu-aberto .menu-botao span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-aberto .menu-botao span:nth-child(2) { opacity: 0; }
  .menu-aberto .menu-botao span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 860px) {
    .menu-botao { display: flex; }
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 8px var(--gutter) 16px;
      background: rgba(14, 14, 14, 0.98);
      border-bottom: 1px solid var(--preto-3);
      box-shadow: 0 16px 30px rgba(0, 0, 0, 0.5);
      font-size: 18px;
      font-weight: 700;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    }
    .menu-aberto .nav { visibility: visible; opacity: 1; transform: none; }
    .nav a { padding: 14px 0; border-bottom: 1px solid var(--preto-3); color: var(--branco); }
    .nav a:last-child { border-bottom: 0; }
  }
  @media (max-width: 420px) {
    .header-cta span { display: none; }
    .header-cta { padding: 10px; }
  }
</style>
