---
// Índice de serviços em texto. As imagens ficam no portfólio; "Ver trabalhos" leva até ele já filtrado.
import { servicos } from '../data/site';
---

<section class="secao secao-tela" id="servicos">
  <div class="container">
    <div class="servicos-topo" data-reveal-grupo>
      <div>
        <span class="tag">O que fazemos</span>
        <h2 class="titulo-secao">Do começo <span>ao fim, com a gente.</span></h2>
      </div>
      <p class="lead">Produção própria, arte inclusa e instalação no seu comércio em São Paulo.</p>
    </div>

    <ul class="indice" data-reveal-grupo>
      {
        servicos.map((s) => (
          <li class="servico">
            <h3 class="servico-nome">{s.titulo}</h3>
            <p class="servico-texto">{s.texto}</p>
            {s.categoria && (
              <a class="servico-ver" href="#portfolio" data-ver={s.categoria}>
                Ver trabalhos
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // "Ver trabalhos" ativa o filtro da categoria no portfólio antes de rolar até ele.
  document.querySelectorAll<HTMLAnchorElement>('[data-ver]').forEach((a) => {
    a.addEventListener('click', () => {
      document.querySelector<HTMLButtonElement>(`[data-filtro="${a.dataset.ver}"]`)?.click();
    });
  });
</script>

<style>
  .servicos-topo { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px 48px; flex-wrap: wrap; }
  /* Um pouco menor que o padrão para o título caber numa linha ao lado do texto. */
  .servicos-topo .titulo-secao { margin-bottom: 0; font-size: clamp(32px, min(4.6vw, 7.5vh), 56px); }
  .servicos-topo .lead { flex: 0 1 34ch; }
  @media (min-width: 961px) {
    .servicos-topo { flex-wrap: nowrap; }
    .servicos-topo .lead { flex: 0 1 30ch; }
  }

  .indice {
    list-style: none;
    margin: clamp(16px, 3vh, 48px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: column;
    grid-template-rows: repeat(3, auto);
    column-gap: clamp(32px, 5vw, 80px);
    border-top: 1px solid var(--preto-3);
  }

  .servico {
    position: relative;
    padding: clamp(10px, 1.7vh, 24px) 0 clamp(10px, 1.7vh, 24px) 22px;
    border-bottom: 1px solid var(--preto-3);
  }
  /* Marcador laranja que cresce ao passar o mouse ou focar um link do serviço. */
  .servico::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 4px;
    height: 0;
    background: var(--laranja);
    transform: translateY(-50%);
    transition: height 0.3s ease;
  }
  .servico:hover::before, .servico:focus-within::before { height: calc(100% - 28px); }

  .servico-nome {
    font-family: var(--fonte-titulo);
    text-transform: uppercase;
    font-size: clamp(24px, min(2.6vw, 4.4vh), 38px);
    line-height: 1.05;
  }
  .servico-texto {
    margin: 6px 0 0;
    color: var(--cinza);
    font-size: 14px;
    line-height: 1.5;
    max-width: 60ch;
  }

  .servico-ver {
    display: inline-block;
    margin-top: 10px;
    font-size: 14px;
    font-weight: 700;
    color: var(--cinza-claro);
    padding: 2px 0;
    border-bottom: 1px solid var(--preto-3);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .servico-ver:hover { color: var(--laranja); border-color: var(--laranja); }
  .servico-ver:focus-visible { outline: 3px solid var(--laranja); outline-offset: 3px; }

  @media (max-width: 700px) {
    .indice { grid-template-columns: 1fr; grid-auto-flow: row; grid-template-rows: none; }
  }
</style>
